{
  "name": "jobcelis/sdk",
  "description": "Official PHP SDK for the Jobcelis Event Infrastructure Platform",
  "type": "library",
  "license": "proprietary",
  "homepage": "https://jobcelis.com",
  "keywords": ["jobcelis", "webhooks", "events", "sdk", "api"],
  "authors": [{"name": "Jobcelis", "email": "support@jobcelis.com"}],
  "require": {"php": ">=8.1", "ext-json": "*", "ext-curl": "*"},
  "require-dev": {"phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"},
  "autoload": {"psr-4": {"Jobcelis\\": "src/"}},
  "autoload-dev": {"psr-4": {"Jobcelis\\Tests\\": "tests/"}},
  "minimum-stability": "stable",
  "support": {
    "source": "https://github.com/jobcelis-team/jobcelis-php",
    "docs": "https://jobcelis.com/docs"
  }
}
